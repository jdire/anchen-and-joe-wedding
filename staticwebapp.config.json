{
  "routes": [
    {
      "route": "/site.css",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/site.js",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/placeholders/*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/websites/*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/login/*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/order-of-the-day/*",
      "allowedRoles": ["ceremony"]
    },
    {
      "route": "/story-time/*",
      "allowedRoles": ["ceremony"]
    },
    {
      "route": "/the-castle/*",
      "allowedRoles": ["ceremony"]
    },
    {
      "route": "/*",
      "allowedRoles": ["authenticated"]
    }
  ],
  "navigationFallback": {
    "rewrite": "/404.html",
    "exclude": ["/*.{css,js,png,gif,jpg,jpeg,svg,webp,ico,woff,woff2}"]
  },
  "responseOverrides": {
    "401": {
      "rewrite": "/login/"
    }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}